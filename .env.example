# ==============================================================================
# AI 合同审查系统 - 环境变量配置模板 (.env.example)
# 复制本文件为 .env 并填入受控环境凭证（.env 已由 .gitignore 严格忽略，严禁提交）
# ==============================================================================

# 1. 核心存储与多租户配置
# 可选值: auto | sqlite | postgres (生产环境配置 CONTRACT_KB_PG_DSN 后强制使用 PostgreSQL，连接失败拒绝静默回退)
CONTRACT_KB_STORAGE_BACKEND=auto
CONTRACT_KB_DB_PATH=data/contract-kb/contract_kb.db
CONTRACT_KB_PG_DSN=
CONTRACT_KB_TENANT_DEFAULT=default
CONTRACT_KB_UPLOAD_RETENTION_SECONDS=0

# 2. 认证与网关信任边界
# 可选值: header | bearer
CONTRACT_KB_AUTH_MODE=header
CONTRACT_KB_AUTH_SHARED_KEY=<CHANGE_ME_STRONG_HMAC_SECRET>
CONTRACT_KB_AUTH_MAX_SKEW_SECONDS=300

# 3. Embedding 与 Reranker 配置
CONTRACT_KB_EMBEDDING_BACKEND=local_hash_256
CONTRACT_KB_EMBEDDING_MODEL=
CONTRACT_KB_EMBEDDING_DIM=256
CONTRACT_KB_EMBEDDING_URL=
CONTRACT_KB_EMBEDDING_API_KEY=
CONTRACT_KB_RERANK_BACKEND=lexical

# 4. 受控外部大模型语义审核配置（未显式开启 ALLOW_EXTERNAL_LLM=true 时严禁外发合同正文）
CONTRACT_KB_ALLOW_EXTERNAL_LLM=false
CONTRACT_KB_LLM_PROVIDER=none
CONTRACT_KB_LLM_BASE_URL=
CONTRACT_KB_LLM_API_KEY=
CONTRACT_KB_LLM_MODEL=
CONTRACT_KB_LLM_TIMEOUT=30
CONTRACT_KB_LLM_MAX_TOKENS=2048

# 5. 外部企业系统只读同步适配器（泛微 e9 / 新系统 tender / 企业微信微盘）
OA_BASE_URL=http://<OA_INTERNAL_HOST>:8088
DB_HOST=<E9_SQLSERVER_HOST>
DB_PORT=1433
DB_USER=<E9_READONLY_USER>
DB_PWD_READONLY=<E9_READONLY_PASSWORD>

MYSQL_HOST=<TENDER_MYSQL_HOST>
MYSQL_PORT=3306
MYSQL_USER=<TENDER_READONLY_USER>
MYSQL_PWD=<TENDER_READONLY_PASSWORD>

WECOM_CORP_ID=ww0000000000000000
WECOM_APP_SECRET=<YOUR_WECOM_APP_SECRET>
WECOM_SPACE_ID=<YOUR_WECOM_SPACE_ID>
WECOM_DOWNLOAD_MAX_MB=10
WECOM_REQUEST_TIMEOUT=20
